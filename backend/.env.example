# Copia este archivo a .env y completá los valores reales antes de correr el backend.
# La app falla si faltan variables obligatorias como DATABASE_URL, JWT_SECRET, CRON_SECRET o MP_TOKEN_ENCRYPTION_KEY.

DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/BASE_DE_DATOS?sslmode=require"
JWT_SECRET="cambiar-por-una-clave-secreta-larga-y-aleatoria"
FRONTEND_URL="http://localhost:5173"

# Credenciales del admin inicial
ADMIN_EMAIL="admin@turnospadel.com"
ADMIN_PASSWORD="CambiarEstaPassword123"

# Mercado Pago
# MP_CLIENT_ID / MP_CLIENT_SECRET son SOLO para el OAuth: conectan la cuenta de Mercado
# Pago del club (pantalla "Conectar con Mercado Pago"). NUNCA se usan para crear o
# consultar pagos.
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_OAUTH_REDIRECT_URI="http://localhost:4000/api/admin/mp/oauth/callback"
# Cifra las credenciales (access_token / refresh_token) de la cuenta del club guardadas
# en CuentaMercadoPago. Generala con: openssl rand -base64 32
MP_TOKEN_ENCRYPTION_KEY="cambiar-por-una-clave-generada-con-openssl-rand-base64-32"

# URL pública del backend para el webhook de Mercado Pago.
# En producción debe ser un dominio público (ej: https://api.turnospadel.com)
BACKEND_URL="http://localhost:4000"

# Config general
PORT=4000
CRON_SECRET="cambiar-por-un-secreto-de-cron"
HOLD_MINUTOS_CHECKOUT=10
HOLD_MINUTOS_COMPROBANTE=30
CANCELACION_HORAS_MIN=24

# Cron interno: expira los holds y concilia Mercado Pago dentro del propio proceso.
# Poner en true si NO hay un cron externo configurado (Railway/Render/GitHub Actions),
# así los holds nunca quedan bloqueados aunque nadie llame a /api/cron/*.
CRON_INTERNO=false

# Directorios opcionales para imágenes
# IMAGENES_DIR="/ruta/para/imagenes"
# COMPROBANTES_DIR="/ruta/para/comprobantes"
